# =============================================================================
# Vibe Kanban — Full Docker Deployment Environment Variables
# =============================================================================
# Copy this file to .env and fill in the required values.
#
#   cp .env.example .env
#
# Then start the stack:
#   docker compose -f docker-compose.full.yml --env-file .env up -d --build
# =============================================================================

# -----------------------------------------------------------------------------
# Required secrets
# -----------------------------------------------------------------------------

# JWT secret for authentication — generate with: openssl rand -base64 48
VIBEKANBAN_REMOTE_JWT_SECRET=

# Password for the ElectricSQL database role (electric_sync user)
ELECTRIC_ROLE_PASSWORD=changeme

# Password for the main PostgreSQL database user
DB_PASSWORD=changeme

# -----------------------------------------------------------------------------
# Claude Code authentication (pick one method)
# -----------------------------------------------------------------------------

# Method A (recommended): Anthropic API key for pay-as-you-go billing.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Method B: Mount your local Claude Code login credentials into the container.
# Uncomment and set to the path of your .claude.json file on the host.
# This uses your Claude subscription instead of pay-as-you-go.
# CLAUDE_AUTH_DIR=~/.claude.json

# -----------------------------------------------------------------------------
# OAuth — at least one provider is required for login
# -----------------------------------------------------------------------------

# GitHub OAuth — https://github.com/settings/developers
# Callback URL: http://localhost:3000/v1/oauth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/v1/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Project folders
# -----------------------------------------------------------------------------

# Host directory containing your git repositories.
# This is bind-mounted into the container at /repos.
# Claude Code reads and writes files in this directory.
REPOS_DIR=/path/to/your/projects

# -----------------------------------------------------------------------------
# Git SSH access (optional)
# -----------------------------------------------------------------------------

# Mount your SSH keys for git operations over SSH.
# Uncomment and set to your .ssh directory on the host.
# SSH_DIR=~/.ssh

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------

# Local vibe-kanban server (with Claude Code support)
VK_LOCAL_PORT=3002

# Remote server (Cloud backend with OAuth + team features)
REMOTE_SERVER_PORTS=127.0.0.1:3000:8081

# Relay server (for tunnel features)
RELAY_SERVER_PORT=8082

# -----------------------------------------------------------------------------
# Domain & URLs (for production deployments)
# -----------------------------------------------------------------------------

# Your public domain name (used by Caddy for automatic HTTPS)
DOMAIN=localhost

# Public base URL for the remote server
# PUBLIC_BASE_URL=https://your-domain.com

# Relay API base URL (passed to frontend at build time)
VITE_RELAY_API_BASE_URL=http://localhost:8082

# -----------------------------------------------------------------------------
# Email (optional — leave empty to disable invitation emails)
# -----------------------------------------------------------------------------

LOOPS_EMAIL_API_KEY=
LOOPS_INVITE_TEMPLATE_ID=cmhvy2wgs3s13z70i1pxakij9
LOOPS_REVIEW_READY_TEMPLATE_ID=cmj47k5ge16990iylued9by17
LOOPS_REVIEW_FAILED_TEMPLATE_ID=cmj49ougk1c8s0iznavijdqpo

# -----------------------------------------------------------------------------
# Analytics & error tracking (optional)
# -----------------------------------------------------------------------------

# POSTHOG_API_KEY=
# POSTHOG_API_ENDPOINT=
# SENTRY_DSN=
# SENTRY_DSN_REMOTE=
